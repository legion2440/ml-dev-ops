# Pinned container images
TRITON_IMAGE=nvcr.io/nvidia/tritonserver:26.07-py3
TRITON_SDK_IMAGE=nvcr.io/nvidia/tritonserver:26.07-py3-sdk
PROMETHEUS_IMAGE=prom/prometheus:v3.11.1
GRAFANA_IMAGE=grafana/grafana:13.1.1
DCGM_EXPORTER_IMAGE=nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless

# Host ports, published on loopback only
TRITON_HTTP_PORT=8000
TRITON_GRPC_PORT=8001
TRITON_METRICS_PORT=8002
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
DCGM_METRICS_PORT=9400

# Repository-relative bind sources
MODEL_REPOSITORY_PATH=./models

# Local development credentials only
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-local-only
