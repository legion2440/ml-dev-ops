{
  "runtime_compatibility_projection": {
    "acceptance": {
      "all_services_healthy": true,
      "gpu_visible": true,
      "persistent_services": [
        "triton",
        "prometheus",
        "grafana",
        "dcgm-exporter"
      ],
      "published_ports_loopback_only": true,
      "successful_checks": [
        "containers",
        "triton_liveness",
        "triton_readiness",
        "triton_no_ready_models",
        "triton_metrics",
        "prometheus_health",
        "prometheus_targets",
        "grafana_health",
        "grafana_datasource",
        "dcgm_metrics"
      ]
    },
    "dcgm_gpu_reservation": {
      "resources": {
        "reservations": {
          "devices": [
            {
              "capabilities": [
                "gpu"
              ],
              "count": "all",
              "driver": "nvidia"
            }
          ]
        }
      }
    },
    "grafana_datasource": [
      {
        "access": "proxy",
        "isDefault": true,
        "name": "Prometheus",
        "type": "prometheus",
        "url": "http://prometheus:9090"
      }
    ],
    "healthchecks": {
      "dcgm-exporter": {
        "interval": "30s",
        "retries": 3,
        "start_period": "20s",
        "test": [
          "CMD",
          "/usr/bin/dcgm-exporter",
          "--version"
        ],
        "timeout": "10s"
      },
      "grafana": {
        "interval": "10s",
        "retries": 12,
        "start_period": "20s",
        "test": [
          "CMD-SHELL",
          "wget --quiet --spider http://127.0.0.1:3000/api/health"
        ],
        "timeout": "5s"
      },
      "prometheus": {
        "interval": "10s",
        "retries": 12,
        "start_period": "10s",
        "test": [
          "CMD-SHELL",
          "wget --quiet --spider http://127.0.0.1:9090/-/healthy"
        ],
        "timeout": "5s"
      },
      "triton": {
        "interval": "10s",
        "retries": 12,
        "start_period": "20s",
        "test": [
          "CMD-SHELL",
          "curl --fail --silent http://127.0.0.1:8000/v2/health/live > /dev/null"
        ],
        "timeout": "5s"
      }
    },
    "images": {
      "dcgm-exporter": "nvcr.io/nvidia/k8s/dcgm-exporter:4.6.0-4.8.3-distroless",
      "grafana": "grafana/grafana:13.1.1",
      "prometheus": "prom/prometheus:v3.11.1",
      "triton": "ml-dev-ops/triton:step2"
    },
    "network": {
      "driver": "bridge"
    },
    "ports": {
      "dcgm-exporter": [
        {
          "host": "127.0.0.1",
          "published": "9400",
          "target": 9400
        }
      ],
      "grafana": [
        {
          "host": "127.0.0.1",
          "published": "3000",
          "target": 3000
        }
      ],
      "prometheus": [
        {
          "host": "127.0.0.1",
          "published": "9090",
          "target": 9090
        }
      ],
      "triton": [
        {
          "host": "127.0.0.1",
          "published": "8000",
          "target": 8000
        },
        {
          "host": "127.0.0.1",
          "published": "8001",
          "target": 8001
        },
        {
          "host": "127.0.0.1",
          "published": "8002",
          "target": 8002
        }
      ]
    },
    "prometheus_scrape": {
      "jobs": [
        {
          "job_name": "prometheus",
          "metrics_path": "/metrics",
          "static_configs": [
            {
              "targets": [
                "prometheus:9090"
              ]
            }
          ]
        },
        {
          "job_name": "triton",
          "metrics_path": "/metrics",
          "static_configs": [
            {
              "targets": [
                "triton:8002"
              ]
            }
          ]
        },
        {
          "job_name": "dcgm-exporter",
          "metrics_path": "/metrics",
          "static_configs": [
            {
              "targets": [
                "dcgm-exporter:9400"
              ]
            }
          ]
        }
      ],
      "scrape_interval": "15s"
    },
    "schema_version": 1,
    "triton_runtime": {
      "build": {
        "args": {
          "TRITON_IMAGE": "${TRITON_IMAGE:?TRITON_IMAGE is required}"
        },
        "context": ".",
        "dockerfile": "deployment/docker/Dockerfile"
      },
      "command": {
        "--allow-grpc": "true",
        "--allow-http": "true",
        "--allow-metrics": "true",
        "--grpc-port": "8001",
        "--http-port": "8000",
        "--metrics-port": "8002",
        "--model-control-mode": "explicit",
        "--model-repository": "/models"
      },
      "gpu_reservation": {
        "resources": {
          "reservations": {
            "devices": [
              {
                "capabilities": [
                  "gpu"
                ],
                "count": "all",
                "driver": "nvidia"
              }
            ]
          }
        }
      },
      "model_repository_mount": [
        {
          "read_only": true,
          "source": "${MODEL_REPOSITORY_PATH:?MODEL_REPOSITORY_PATH is required}",
          "target": "/models",
          "type": "bind"
        }
      ],
      "source_image": "nvcr.io/nvidia/tritonserver:26.07-py3"
    }
  },
  "runtime_compatibility_projection_sha256": "df588720cd1eea0bcbd4690b6f0978421fbaf2b4f1651933a35b99d642aaaa4a",
