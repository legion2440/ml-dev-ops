{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/legion2440/ml-dev-ops/schemas/model-spec.schema.json",
  "title": "Model specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository_license", "requirements_lock", "build", "models"],
  "properties": {
    "schema_version": {"const": 2},
    "repository_license": {"const": "AGPL-3.0-only"},
    "requirements_lock": {"const": "scripts/model_preparation/requirements.lock"},
    "build": {
      "type": "object",
      "additionalProperties": false,
      "required": ["exporter_image", "exporter_local_image", "tensorrt_builder_image", "onnx_opset", "simplify"],
      "properties": {
        "exporter_image": {"$ref": "#/$defs/image"},
        "exporter_local_image": {"type": "string", "minLength": 1},
        "tensorrt_builder_image": {"$ref": "#/$defs/image"},
        "onnx_opset": {"type": "integer", "minimum": 13, "maximum": 21},
        "simplify": {"const": false}
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resnet50", "yolo11n"],
      "properties": {
        "resnet50": {"$ref": "#/$defs/resnet"},
        "yolo11n": {"$ref": "#/$defs/yolo"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "path": {"type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
    "image": {"type": "string", "pattern": "^[a-z0-9./_-]+:[A-Za-z0-9][A-Za-z0-9._-]*@sha256:[0-9a-f]{64}$"},
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "FP32"},
        "shape": {
          "type": "array",
          "minItems": 2,
          "items": {"type": "integer"}
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["framework", "identifier", "url", "filename", "hash_status", "sha256", "code_license"],
      "properties": {
        "framework": {"enum": ["torchvision", "ultralytics"]},
        "identifier": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "hash_status": {"enum": ["unresolved", "resolved"]},
        "sha256": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/sha256"}]},
        "code_license": {"type": "string", "minLength": 1},
        "weights_license": {"type": "string", "minLength": 1},
        "weights_terms": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "labels": {
      "type": "object",
      "required": ["source_url", "source_sha256", "generated_sha256", "filename", "count"],
      "properties": {
        "source_url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "generated_sha256": {"$ref": "#/$defs/sha256"},
        "filename": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
        "count": {"type": "integer", "minimum": 1},
        "extraction": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "export": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dynamic_axes", "nms"],
      "properties": {
        "dynamic_axes": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 2,
          "additionalProperties": {
            "type": "array",
            "items": {"const": "batch"},
            "minItems": 1,
            "maxItems": 1
          }
        },
        "nms": {"const": false}
      }
    },
    "numeric_range": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "resnet_preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resize", "center_crop", "scale", "mean", "std"],
      "properties": {
        "resize": {"type": "integer", "minimum": 1},
        "center_crop": {"type": "integer", "minimum": 1},
        "scale": {"$ref": "#/$defs/numeric_range"},
        "mean": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "std": {"type": "array", "minItems": 1, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "yolo_preprocessing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resize", "scale", "channel_order"],
      "properties": {
        "resize": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "scale": {"$ref": "#/$defs/numeric_range"},
        "channel_order": {"type": "string", "minLength": 1}
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_path", "revision"],
      "properties": {
        "artifact_path": {"$ref": "#/$defs/path"},
        "revision": {"type": "string", "minLength": 1},
        "derived_from": {"type": "string", "pattern": "^[1-9][0-9]*$"},
        "transform": {"type": "string", "minLength": 1}
      },
      "dependentRequired": {
        "derived_from": ["transform"],
        "transform": ["derived_from"]
      }
    },
    "versions": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[1-9][0-9]*$"},
      "additionalProperties": {"$ref": "#/$defs/version"}
    },
    "version_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["specific"],
      "properties": {
        "specific": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 1}
        }
      }
    },
    "scheduling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dynamic_batching"],
      "properties": {
        "dynamic_batching": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preferred_batch_sizes", "max_queue_delay_microseconds"],
          "properties": {
            "preferred_batch_sizes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "integer", "minimum": 1}
            },
            "max_queue_delay_microseconds": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "onnx_serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config_path", "precision", "max_batch_size", "versions", "version_policy", "scheduling"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "config_path": {"$ref": "#/$defs/path"},
        "precision": {"const": "FP32"},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "versions": {"$ref": "#/$defs/versions"},
        "version_policy": {"$ref": "#/$defs/version_policy"},
        "scheduling": {"$ref": "#/$defs/scheduling"}
      }
    },
    "tensorrt_serving": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "config_path", "precision", "compute_precision", "io_precision", "max_batch_size", "versions", "version_policy", "scheduling", "profile"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "config_path": {"$ref": "#/$defs/path"},
        "precision": {"const": "FP16"},
        "compute_precision": {"const": "FP16"},
        "io_precision": {"const": "FP32"},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "versions": {"$ref": "#/$defs/versions"},
        "version_policy": {"$ref": "#/$defs/version_policy"},
        "scheduling": {"$ref": "#/$defs/scheduling"},
        "profile": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "opt", "max"],
          "properties": {
            "min": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
            "opt": {"type": "array", "minItems": 2, "items": {"type": "integer"}},
            "max": {"type": "array", "minItems": 2, "items": {"type": "integer"}}
          }
        }
      }
    },
    "resnet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "preprocessing", "input", "output", "export", "labels", "serving", "smoke_batches", "parity", "version_parity"],
      "properties": {
        "source": {
          "allOf": [
            {"$ref": "#/$defs/source"},
            {"required": ["weights_terms"]}
          ]
        },
        "preprocessing": {"$ref": "#/$defs/resnet_preprocessing"},
        "input": {"$ref": "#/$defs/tensor"},
        "output": {"$ref": "#/$defs/tensor"},
        "export": {"$ref": "#/$defs/export"},
        "labels": {"$ref": "#/$defs/labels"},
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["onnx", "tensorrt"],
          "properties": {
            "onnx": {"$ref": "#/$defs/onnx_serving"},
            "tensorrt": {"$ref": "#/$defs/tensorrt_serving"}
          }
        },
        "smoke_batches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "parity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_abs_error", "mean_abs_error", "minimum_cosine_similarity", "minimum_top1_agreement"],
          "properties": {
            "max_abs_error": {"type": "number", "exclusiveMinimum": 0},
            "mean_abs_error": {"type": "number", "exclusiveMinimum": 0},
            "minimum_cosine_similarity": {"type": "number", "minimum": 0, "maximum": 1},
            "minimum_top1_agreement": {"type": "number", "minimum": 0, "maximum": 1}
          }
        },
        "version_parity": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_abs_error", "mean_abs_error", "minimum_cosine_similarity", "minimum_top1_agreement"],
          "properties": {
            "max_abs_error": {"type": "number", "minimum": 0},
            "mean_abs_error": {"type": "number", "minimum": 0},
            "minimum_cosine_similarity": {"type": "number", "minimum": 0, "maximum": 1},
            "minimum_top1_agreement": {"type": "number", "minimum": 0, "maximum": 1}
          }
        }
      }
    },
    "yolo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "preprocessing", "input", "output", "export", "labels", "serving", "smoke_batches"],
      "properties": {
        "source": {
          "allOf": [
            {"$ref": "#/$defs/source"},
            {"required": ["weights_license"]}
          ]
        },
        "preprocessing": {"$ref": "#/$defs/yolo_preprocessing"},
        "input": {"$ref": "#/$defs/tensor"},
        "output": {"$ref": "#/$defs/tensor"},
        "export": {"$ref": "#/$defs/export"},
        "labels": {"$ref": "#/$defs/labels"},
        "serving": {
          "type": "object",
          "additionalProperties": false,
          "required": ["onnx"],
          "properties": {"onnx": {"$ref": "#/$defs/onnx_serving"}}
        },
        "smoke_batches": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
      }
    }
  }
}
