{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/benchmark-host-telemetry.schema.json",
  "title": "Windows host benchmark telemetry sample",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "observed_at_utc", "host_monotonic_ns", "sample_kind", "device_metrics_source_sequence", "collection_ok", "gpu", "wddm_adapters", "gpu_engine_inventory", "gpu_engines", "nvidia_processes", "error"],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "observed_at_utc": {"type": "string", "format": "date-time"},
    "host_monotonic_ns": {"type": "integer", "minimum": 1},
    "sample_kind": {"enum": ["periodic", "boundary"]},
    "device_metrics_source_sequence": {"type": "integer", "minimum": 1},
    "collection_ok": {"type": "boolean"},
    "gpu": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["uuid", "utilization_percent", "memory_used_mib", "memory_total_mib", "sm_clock_mhz", "memory_clock_mhz", "pstate", "power_draw_watts", "temperature_celsius", "pci_bus_id"],
          "properties": {
            "uuid": {"type": "string", "pattern": "^GPU-[A-Za-z0-9-]+$"},
            "utilization_percent": {"type": ["number", "null"], "minimum": 0, "maximum": 100},
            "memory_used_mib": {"type": ["integer", "null"], "minimum": 0},
            "memory_total_mib": {"type": ["integer", "null"], "minimum": 1},
            "sm_clock_mhz": {"type": ["integer", "null"], "minimum": 0},
            "memory_clock_mhz": {"type": ["integer", "null"], "minimum": 0},
            "pstate": {"type": ["string", "null"]},
            "power_draw_watts": {"type": ["number", "null"], "minimum": 0},
            "temperature_celsius": {"type": ["number", "null"]},
            "pci_bus_id": {"type": ["string", "null"]}
          }
        }
      ]
    },
    "wddm_adapters": {
      "type": "array",
      "items": {"$ref": "#/$defs/adapter"}
    },
    "gpu_engines": {
      "type": "array",
      "items": {"$ref": "#/$defs/engine"}
    },
    "gpu_engine_inventory": {
      "type": "array",
      "items": {"$ref": "#/$defs/engine_inventory"}
    },
    "nvidia_processes": {
      "type": "array",
      "items": {"$ref": "#/$defs/nvidia_process"}
    },
    "error": {"type": ["string", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"collection_ok": {"const": true}}},
      "then": {
        "properties": {
          "gpu": {"type": "object"},
          "wddm_adapters": {"minItems": 1},
          "gpu_engine_inventory": {"minItems": 1},
          "error": {"type": "null"}
        }
      },
      "else": {
        "properties": {
          "gpu": {"type": "null"},
          "gpu_engine_inventory": {"maxItems": 0},
          "gpu_engines": {"maxItems": 0},
          "error": {"type": "string", "minLength": 1}
        }
      }
    }
  ],
  "$defs": {
    "adapter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "vendor_id", "device_id", "luid"],
      "properties": {
        "description": {"type": "string", "minLength": 1},
        "vendor_id": {"const": 4318},
        "device_id": {"type": "integer", "minimum": 1},
        "luid": {"type": "string", "pattern": "^0x[0-9A-F]{8}_0x[0-9A-F]{8}$"}
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_name", "adapter_luid", "physical_adapter_index", "engine_index", "engine_type", "utilization_percent"],
      "properties": {
        "pid": {"type": "integer", "minimum": 0},
        "process_name": {"type": "string", "minLength": 1},
        "adapter_luid": {"type": "string", "pattern": "^0x[0-9A-F]{8}_0x[0-9A-F]{8}$"},
        "physical_adapter_index": {"type": "integer", "minimum": 0},
        "engine_index": {"type": "integer", "minimum": 0},
        "engine_type": {"type": "string", "minLength": 1},
        "utilization_percent": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "engine_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_name", "adapter_luids", "engine_types", "instance_count"],
      "properties": {
        "pid": {"type": "integer", "minimum": 0},
        "process_name": {"type": "string", "minLength": 1},
        "adapter_luids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^0x[0-9A-F]{8}_0x[0-9A-F]{8}$"}},
        "engine_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "instance_count": {"type": "integer", "minimum": 1}
      }
    },
    "nvidia_process": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pid", "process_name", "gpu_memory_mib", "gpu_utilization_percent", "gpu_memory_utilization_percent"],
      "properties": {
        "pid": {"type": "integer", "minimum": 0},
        "process_name": {"type": "string", "minLength": 1},
        "gpu_memory_mib": {"type": ["integer", "null"], "minimum": 0},
        "gpu_utilization_percent": {"type": ["number", "null"], "minimum": 0},
        "gpu_memory_utilization_percent": {"type": ["number", "null"], "minimum": 0}
      }
    }
  }
}
