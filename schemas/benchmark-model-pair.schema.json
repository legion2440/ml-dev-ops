{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/benchmark-model-pair.schema.json",
  "title": "Generated benchmark optimization-pair contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_manifest_sha256",
    "pair_id",
    "logical_model_id",
    "weights_sha256",
    "common_contract",
    "common_contract_sha256",
    "parity",
    "baseline",
    "optimized",
    "declared_build_target"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "pair_id": {"const": "resnet50-onnx-vs-tensorrt"},
    "logical_model_id": {"const": "resnet50"},
    "weights_sha256": {"$ref": "#/$defs/sha256"},
    "common_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "preprocessing", "max_batch_size", "scheduling", "instance_group"],
      "properties": {
        "input": {"$ref": "#/$defs/tensor"},
        "output": {"$ref": "#/$defs/tensor"},
        "preprocessing": {"type": "object", "minProperties": 1},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "scheduling": {"type": "object", "minProperties": 1},
        "instance_group": {"type": "array"}
      }
    },
    "common_contract_sha256": {"$ref": "#/$defs/sha256"},
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "max_abs_error", "mean_abs_error", "cosine_similarity", "top1_agreement", "tolerances"],
      "properties": {
        "status": {"const": "passed"},
        "max_abs_error": {"type": "number", "minimum": 0},
        "mean_abs_error": {"type": "number", "minimum": 0},
        "cosine_similarity": {"type": "number", "minimum": -1, "maximum": 1},
        "top1_agreement": {"type": "number", "minimum": 0, "maximum": 1},
        "tolerances": {"type": "object", "minProperties": 1}
      }
    },
    "baseline": {"$ref": "#/$defs/model"},
    "optimized": {"$ref": "#/$defs/model"},
    "declared_build_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_name", "compute_capability", "build_driver_version"],
      "properties": {
        "gpu_name": {"type": "string", "minLength": 1},
        "compute_capability": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "build_driver_version": {"type": "string", "minLength": 1}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tensor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "FP32"},
        "shape": {"type": "array", "minItems": 2, "items": {"type": "integer"}}
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "version", "available_versions", "runtime", "compute_precision", "io_precision"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "version": {"const": "1"},
        "available_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}},
        "runtime": {"enum": ["onnxruntime", "tensorrt"]},
        "compute_precision": {"enum": ["FP32", "FP16"]},
        "io_precision": {"const": "FP32"}
      }
    }
  }
}
