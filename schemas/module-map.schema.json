{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "module-map.schema.json",
  "title": "ML DevOps module map",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "path_policy",
    "modules",
    "repository_artifacts"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "repository": {
      "const": "ml-dev-ops"
    },
    "path_policy": {
      "const": "repository-relative-posix"
    },
    "modules": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/module"
      }
    },
    "repository_artifacts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/pathReference"
      }
    }
  },
  "$defs": {
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "pathReference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/repositoryPath"
        },
        "status": {
          "enum": [
            "planned",
            "implemented",
            "generated"
          ]
        },
        "generator": {
          "$ref": "#/$defs/repositoryPath"
        },
        "checker": {
          "$ref": "#/$defs/repositoryPath"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repositoryPath"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "generated"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "generator",
              "sources"
            ]
          }
        }
      ]
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "description",
        "module_type",
        "root",
        "entrypoints",
        "public_interfaces",
        "tests",
        "docs",
        "generated_artifacts",
        "owned_configuration"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "module_type": {
          "enum": [
            "application",
            "artifact",
            "library",
            "operations",
            "service",
            "tooling"
          ]
        },
        "root": {
          "$ref": "#/$defs/repositoryPath"
        },
        "entrypoints": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        },
        "public_interfaces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        },
        "tests": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        },
        "docs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        },
        "generated_artifacts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        },
        "owned_configuration": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/pathReference"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "module_type": {
                "const": "artifact"
              }
            },
            "required": [
              "module_type"
            ]
          },
          "else": {
            "properties": {
              "entrypoints": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
