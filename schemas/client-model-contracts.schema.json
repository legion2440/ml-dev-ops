{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schemas/client-model-contracts.schema.json",
  "title": "Generated client model contracts",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_manifest_sha256", "models"],
  "properties": {
    "schema_version": {"const": 1},
    "source_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resnet50_onnx", "resnet50_tensorrt", "yolo11n_onnx"],
      "properties": {
        "resnet50_onnx": {"$ref": "#/$defs/model"},
        "resnet50_tensorrt": {"$ref": "#/$defs/model"},
        "yolo11n_onnx": {"$ref": "#/$defs/model"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tensor": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "dtype", "shape"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "dtype": {"const": "FP32"},
        "shape": {"type": "array", "minItems": 2, "items": {"type": "integer"}}
      }
    },
    "model": {
      "type": "object", "additionalProperties": false,
      "required": ["task", "max_batch_size", "versions", "input", "output", "preprocessing", "labels", "output_semantics"],
      "properties": {
        "task": {"enum": ["classification", "detection"]},
        "max_batch_size": {"type": "integer", "minimum": 1},
        "versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[1-9][0-9]*$"}},
        "input": {"$ref": "#/$defs/tensor"},
        "output": {"$ref": "#/$defs/tensor"},
        "preprocessing": {"type": "object", "minProperties": 1},
        "labels": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "output_semantics": {"type": "object", "minProperties": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"task": {"const": "classification"}}},
          "then": {
            "properties": {
              "preprocessing": {"$ref": "#/$defs/classificationPreprocessing"},
              "output_semantics": {"$ref": "#/$defs/classificationOutput"}
            }
          }
        },
        {
          "if": {"properties": {"task": {"const": "detection"}}},
          "then": {
            "properties": {
              "preprocessing": {"$ref": "#/$defs/detectionPreprocessing"},
              "output_semantics": {"$ref": "#/$defs/detectionOutput"}
            }
          }
        }
      ]
    },
    "scale": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {"type": "number"}
    },
    "classificationPreprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_order", "tensor_layout", "resize", "center_crop", "scale", "mean", "std"],
      "properties": {
        "channel_order": {"const": "RGB"},
        "tensor_layout": {"const": "CHW"},
        "resize": {"type": "integer", "minimum": 1},
        "center_crop": {"type": "integer", "minimum": 1},
        "scale": {"$ref": "#/$defs/scale"},
        "mean": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number"}},
        "std": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "exclusiveMinimum": 0}}
      }
    },
    "detectionPreprocessing": {
      "type": "object", "additionalProperties": false,
      "required": ["channel_order", "tensor_layout", "resize", "resize_mode", "letterbox_center", "padding_value", "scale"],
      "properties": {
        "channel_order": {"const": "RGB"},
        "tensor_layout": {"const": "CHW"},
        "resize": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "integer", "minimum": 1}},
        "resize_mode": {"const": "letterbox"},
        "letterbox_center": {"const": true},
        "padding_value": {"type": "integer", "minimum": 0, "maximum": 255},
        "scale": {"$ref": "#/$defs/scale"}
      }
    },
    "classificationOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind"],
      "properties": {"kind": {"const": "logits"}}
    },
    "detectionOutput": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "box_format", "class_scores_start", "has_objectness", "class_aware_nms"],
      "properties": {
        "kind": {"const": "yolo_xywh_class_scores"},
        "box_format": {"const": "xywh"},
        "class_scores_start": {"const": 4},
        "has_objectness": {"const": false},
        "class_aware_nms": {"const": true}
      }
    }
  }
}
