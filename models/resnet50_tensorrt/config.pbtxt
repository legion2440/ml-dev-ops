name: "resnet50_tensorrt"
platform: "tensorrt_plan"
max_batch_size: 8
cc_model_filenames {
  key: "8.9"
  value: "model_cc89.plan"
}
input [
  {
    name: "images"
    data_type: TYPE_FP32
    dims: [ 3, 224, 224 ]
  }
]
output [
  {
    name: "logits"
    data_type: TYPE_FP32
    dims: [ 1000 ]
    label_filename: "imagenet1k.txt"
  }
]
